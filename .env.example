# Copy to .env and adjust. docker compose reads this file automatically.

# development | production | test  (production enforces a strong SECRET_KEY and no wildcard CORS)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local dev default is SQLite; docker compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./chat.db
# DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
DB_AUTO_CREATE_TABLES=true
REDIS_URL=redis://localhost:6379/0

# Comma separated origins
CORS_ORIGINS=http://localhost:8000
WS_ALLOWED_ORIGINS=http://localhost:8000

# Limits
WS_MAX_MESSAGE_BYTES=16384
MESSAGE_MAX_LENGTH=4000
WS_MAX_CONNECTIONS_PER_USER=10
WS_RATE_LIMIT_COUNT=20
WS_RATE_LIMIT_WINDOW_SECONDS=10
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# docker compose only
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=chat
HTTP_PORT=8000
WEB_CONCURRENCY=2
